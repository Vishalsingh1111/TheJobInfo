{
    "rewrites": [
        { "source": "/sitemap.xml", "destination": "/api/sitemap" },
        { "source": "/jobdetail/:slug", "destination": "/api/page?type=job&slug=:slug" },
        { "source": "/blogs/:slug", "destination": "/api/page?type=blog&slug=:slug" },
        { "source": "/(.*)", "destination": "/index.html" }
    ],
    "functions": {
        "api/page.js": { "includeFiles": "dist/index.html", "maxDuration": 10 },
        "api/sitemap.js": { "maxDuration": 10 }
    }
}